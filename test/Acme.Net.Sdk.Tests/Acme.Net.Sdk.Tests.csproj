      <Link>vectors\protocol.4.json</Link> <!-- This places it in a 'vectors' subdirectory in the output -->
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
