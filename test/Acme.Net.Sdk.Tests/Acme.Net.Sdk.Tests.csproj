  <ItemGroup>
    <Compile Include="..\..\src\Acme.Net.Sdk\Protocol\QueryResponseType.cs" Link="Protocol\QueryResponseType.cs" />
     Add other files here if necessary 
  </ItemGroup>
  -->

  <ItemGroup>
    <!-- This assumes the submodule path is ../../test/vectors relative to this csproj file -->
    <!-- Adjust the path if your submodule is located differently -->
