<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ship XML doc comments so IntelliSense and AI agents see the ~5.5k /// docs (P1-CS-01) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.1.1</Version>
    <PackageId>Acme.Net.Sdk</PackageId>
    <Authors>OpenDLT</Authors>
    <Description>Accumulate C# SDK (V2/V3 unified) with SmartSigner, TxBody builders, and Ed25519 signing</Description>
    <RepositoryUrl>https://github.com/opendlt/accumulate-csharp-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/opendlt/accumulate-csharp-sdk</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>accumulate;blockchain;sdk;json-rpc;crypto;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>

</Project>
