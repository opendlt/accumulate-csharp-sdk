<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageId>Acme.Net.Sdk</PackageId>
    <Authors>OpenDLT</Authors>
    <Description>Accumulate C# SDK (V2/V3 unified) with SmartSigner, TxBody builders, and Ed25519 signing</Description>
    <RepositoryUrl>https://gitlab.com/accumulatenetwork/sdk/acme.net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>

</Project>
